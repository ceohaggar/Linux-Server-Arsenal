# --- Acces Meta WhatsApp Cloud API ---
# Token d'acces (permanent de preference, via une app systeme Meta Business)
WHATSAPP_TOKEN=
# ID du numero de telephone WhatsApp (visible dans le tableau de bord Meta)
WHATSAPP_PHONE_NUMBER_ID=
# Version de l'API Graph
GRAPH_API_VERSION=v21.0

# Jeton de verification du webhook (choisis n'importe quelle chaine secrete,
# la meme que tu saisiras dans la config du webhook chez Meta)
WEBHOOK_VERIFY_TOKEN=agrovia-verify-token-a-changer

# --- Plateforme ---
PORT=3000
# Mot de passe du tableau de bord
ADMIN_PASSWORD=change-moi
# Secret de session (chaine aleatoire longue)
SESSION_SECRET=change-moi-aussi
# Numeros WhatsApp des admins a notifier (format international sans +, separes par des virgules)
# Exemple : 23566000001,23599000002
ADMIN_NUMBERS=

# Mode simulation : true = aucun appel reel a Meta (demo/test sans credentials)
# Se met automatiquement en simulation si WHATSAPP_TOKEN est vide.
SIMULATE=false

# Delai entre deux envois de campagne en millisecondes (respect des limites Meta)
CAMPAIGN_SEND_INTERVAL_MS=1100
